# Postgres connection strings (Prisma postgresql provider — see prisma/schema.prisma)
# Neon: get these from your project's Connect / Connection Details panel.
# DATABASE_URL is the pooled (PgBouncer) endpoint the running app uses;
# DIRECT_URL is the non-pooled endpoint Prisma Migrate needs (add
# pgbouncer=true to DATABASE_URL, and drop "-pooler" from the host for DIRECT_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Secret for the keyed references that stand in for email addresses in log
# lines (src/lib/emailRef.ts). At least 32 characters, no whitespace; generate
# 32 random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset, every account is logged as "unkeyed" and the server warns at startup.
LOG_EMAIL_KEY=
