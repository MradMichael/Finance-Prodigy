# SEC-04 / R1: the secret the site's /api proxy route shares with the server (the SAME value as the server's
# ESSA_PROXY_KEY). With it set, the route tells the server which address is calling, so rate limits count per
# person. At least 32 characters. Server side only: never give it a NEXT_PUBLIC_ name. Unset, nothing is sent.
ESSA_PROXY_KEY=

API_URL=http://localhost:4000

# Set by Vercel itself at build time (a system variable; nothing to configure). sw/build-sw.mjs puts its first
# 7 characters in the service worker, so Profile can show which commit a phone is running. Unset locally: the
# version line then shows the build ID only.
# VERCEL_GIT_COMMIT_SHA=
